package serie2;

import java.util.ArrayList;
import java.util.List;

public class runOptimal {
	public static void runOptimal(int[] ref, int framesCount) {
        List<Integer> frames = new ArrayList<>();
        int pageFaults = 0;

        for (int i = 0; i < ref.length; i++) {
            int currentPage = ref[i];
            if (!frames.contains(currentPage)) {
                if (frames.size() < framesCount) {
                    frames.add(currentPage);
                } else {
                    // البحث عن الصفحة الأبعد في المستقبل
                    int farthest = -1, victimIndex = 0;
                    for (int j = 0; j < frames.size(); j++) {
                        int nextUse = Integer.MAX_VALUE;
                        for (int k = i + 1; k < ref.length; k++) {
                            if (frames.get(j) == ref[k]) {
                                nextUse = k;
                                break;
                            }
                        }
                        if (nextUse > farthest) {
                            farthest = nextUse;
                            victimIndex = j;
                        }
                    }
                    frames.set(victimIndex, currentPage);
                }
                pageFaults++;
            }
            System.out.println("Ref " + currentPage + ": " + frames);
        }
        System.out.println("Total Page Faults (Optimal): " + pageFaults);
    }
}

