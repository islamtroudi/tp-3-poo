package serie2;

import java.util.ArrayList;
import java.util.List;

public class runLRU {
	public static void runLRU(int[] ref, int framesCount) {
        List<Integer> frames = new ArrayList<>();
        int pageFaults = 0;

        System.out.println("\nLRU Execution States:");
        for (int i = 0; i < ref.length; i++) {
            int currentPage = ref[i];
            if (!frames.contains(currentPage)) {
                if (frames.size() < framesCount) {
                    frames.add(currentPage);
                } else {
                    int farthest = i, victimIndex = 0;
                    for (int j = 0; j < frames.size(); j++) {
                        int lastUse = -1;
                        for (int k = i - 1; k >= 0; k--) {
                            if (frames.get(j) == ref[k]) {
                                lastUse = k;
                                break;
                            }
                        }
                        if (lastUse < farthest) {
                            farthest = lastUse;
                            victimIndex = j;
                        }
                    }
                    frames.set(victimIndex, currentPage);
                }
                pageFaults++;
            }
            System.out.println("Ref " + currentPage + ": " + frames);
        }
        System.out.println("Total Page Faults (LRU): " + pageFaults);
    }
}
